{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read f; case \"$f\" in *.ts|*.tsx|*.mjs|*.css|*.json|*.md|*.mdx) pnpm exec prettier --write \"$f\" >/dev/null 2>&1 || true ;; esac; }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm typecheck && pnpm test",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
